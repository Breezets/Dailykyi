# Dailykyi 环境变量配置示例
# 复制为 .env 后按需修改，生产环境务必修改密钥与默认密码

# 应用
DAILYKYI_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
DAILYKYI_LOG_LEVEL=INFO

# 数据库（生产保持默认即可，使用容器内挂载的 /app/data）
DAILYKYI_DATABASE_URL=sqlite+aiosqlite:///data/dailykyi.db

# 默认管理员账号（首次登录后会强制要求修改密码）
DAILYKYI_DEFAULT_USERNAME=2233
DAILYKYI_DEFAULT_PASSWORD=tv23333

# 登录安全
DAILYKYI_MAX_LOGIN_ATTEMPTS=5
DAILYKYI_LOGIN_LOCKOUT_MINUTES=10
