# Dailykyi 行尾与二进制文件规范
# 说明：统一所有文本文件在仓库中存储为 LF（Linux 风格换行）
# Windows 用户 checkout 时 Git 会自动转成 CRLF，add 时再转回 LF（正常行为）

# === 通用文本：提交和仓库一律用 LF ===
*       text=auto eol=lf

# === 代码文件（显式声明，避免被识别为二进制） ===
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.conf  text eol=lf
*.env*  text eol=lf
*.mako  text eol=lf
*.sql   text eol=lf

# === Windows 脚本：本机保留 CRLF（可按需开启） ===
# *.bat  text eol=crlf
# *.cmd  text eol=crlf
# *.ps1  text eol=crlf

# === 二进制文件：不要改换行符，不要 diff ===
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svgz  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.db    binary
*.sqlite binary
*.sqlite3 binary
*.pyc   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.exe   binary
*.mp4   binary
*.mp3   binary
